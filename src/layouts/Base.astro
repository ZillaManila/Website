---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'product' | 'article';
  noindex?: boolean;
}
const { title, description = site.description, image = '/images/og.jpg', type = 'website', noindex = false } = Astro.props;
const fullTitle = title ? `${title} | Gummikins™` : `Gummikins™ | Handmade crochet plush companions`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f7efe6" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content="Gummikins" />
    <meta property="og:type" content={type === 'product' ? 'product' : type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CartDrawer />
    <script>
      import '../scripts/site';
    </script>
    <style is:global>
      .skip {
        position: absolute;
        left: 1rem;
        top: -100px;
        z-index: 100;
        padding: 0.8rem 1.2rem;
        background: var(--chocolate);
        color: var(--cream);
        border-radius: 999px;
      }
      .skip:focus {
        top: 1rem;
      }
    </style>
  </body>
</html>
