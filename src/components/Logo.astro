---
// Placeholder wordmark + icon drawn from the brand board.
// Swap for the final SVG files from the owners when they arrive.
interface Props {
  size?: 'sm' | 'md' | 'lg';
  iconOnly?: boolean;
}
const { size = 'md', iconOnly = false } = Astro.props;
---

<span class:list={['logo', `logo--${size}`]}>
  <svg class="logo__icon" viewBox="0 0 64 64" aria-hidden="true">
    <path
      d="M32 8c-4 0-6.5 2.6-6.5 5.6 0 1.6.7 2.9 1.8 3.9C15.6 19.9 8 29.4 8 40.5 8 50.5 18.6 56 32 56s24-5.5 24-15.5c0-11.1-7.6-20.6-19.3-23 1.1-1 1.8-2.3 1.8-3.9C38.5 10.6 36 8 32 8Z"
      fill="var(--logo-fill, #fbf6ef)"
      stroke="currentColor"
      stroke-width="3.2"
      stroke-linejoin="round"></path>
    <circle cx="24" cy="37" r="3.1" fill="currentColor"></circle>
    <circle cx="40" cy="37" r="3.1" fill="currentColor"></circle>
    <ellipse cx="19.5" cy="43" rx="3.4" ry="2.2" fill="#d68c87" opacity=".75"></ellipse>
    <ellipse cx="44.5" cy="43" rx="3.4" ry="2.2" fill="#d68c87" opacity=".75"></ellipse>
    <path d="M28 43.5c2.2 2.4 5.8 2.4 8 0" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"></path>
  </svg>
  {
    !iconOnly && (
      <span class="logo__word">
        Gummikins<sup>™</sup>
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    color: var(--chocolate);
    line-height: 1;
  }
  .logo__icon {
    width: 1.55em;
    height: 1.55em;
    flex: none;
    transition: transform 0.5s var(--ease-spring);
  }
  .logo:hover .logo__icon {
    transform: rotate(-8deg) scale(1.08, 0.94);
  }
  .logo__word {
    font-family: var(--font-hand);
    font-size: 1.5em;
    letter-spacing: 0.01em;
    padding-top: 0.08em;
  }
  sup {
    font-family: var(--font-body);
    font-size: 0.3em;
    font-weight: 700;
    vertical-align: top;
    margin-left: 0.1em;
    position: relative;
    top: 0.3em;
  }
  .logo--sm {
    font-size: 0.9rem;
  }
  .logo--md {
    font-size: 1.1rem;
  }
  .logo--lg {
    font-size: 1.9rem;
  }
</style>
