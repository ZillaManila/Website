---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav } from '../data/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<div class="announce">
  <p>
    <Icon name="heart" class="announce__heart" />
    Every order comes with a free <a href="/faq#little-drop">Little Drop</a>, as supplies last.
  </p>
</div>
<header class="site-header" data-header>
  <div class="wrap site-header__inner">
    <a href="/" class="site-header__logo" aria-label="Gummikins home"><Logo /></a>
    <nav class="site-nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="site-header__actions">
      <a href="/shop" class="btn site-header__shop">Shop Gummikins</a>
      <button class="icon-btn cart-btn" type="button" data-cart-open aria-label="Open cart">
        <Icon name="bag" />
        <span class="cart-btn__count" data-cart-count hidden>0</span>
      </button>
      <button class="icon-btn menu-btn" type="button" data-menu-open aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <Icon name="menu" />
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" data-menu hidden>
  <div class="mobile-menu__top wrap">
    <Logo />
    <button class="icon-btn" type="button" data-menu-close aria-label="Close menu"><Icon name="close" /></button>
  </div>
  <nav class="wrap" aria-label="Mobile">
    <ul>
      <li style="--i:0"><a href="/">Home</a></li>
      {
        nav.map((item, i) => (
          <li style={`--i:${i + 1}`}>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
      <li style={`--i:${nav.length + 1}`}><a href="/journal">Journal</a></li>
      <li style={`--i:${nav.length + 2}`}><a href="/contact">Contact</a></li>
    </ul>
    <a href="/shop" class="btn btn--block">Shop Gummikins <Icon name="arrow" /></a>
  </nav>
</div>

<style>
  .announce {
    position: relative;
    z-index: 2;
    background: var(--chocolate);
    color: var(--cream);
    text-align: center;
    font-size: 0.82rem;
    font-weight: 550;
    padding: 0.55rem var(--gutter);
  }
  .announce p {
    margin: 0 auto;
    max-width: none;
  }
  .announce a {
    color: inherit;
  }
  :global(.announce__heart) {
    width: 1rem;
    height: 1rem;
    color: var(--clay-rose);
    display: inline-block;
    vertical-align: -0.18em;
    margin-right: 0.35em;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--cream) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .site-header.is-scrolled {
    border-color: rgba(91, 64, 50, 0.1);
    box-shadow: 0 10px 30px -24px rgba(91, 64, 50, 0.5);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 68px;
  }
  .site-header__logo {
    text-decoration: none;
  }
  .site-nav ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav a {
    display: block;
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: background-color 0.2s;
  }
  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    background: rgba(140, 159, 122, 0.2);
  }
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .site-header__shop {
    min-height: 44px;
    padding: 0.6em 1.2em;
    font-size: 0.9rem;
  }
  .icon-btn {
    position: relative;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--chocolate);
    cursor: pointer;
    transition: background-color 0.2s, transform 0.3s var(--ease-spring);
  }
  .icon-btn:hover {
    background: rgba(91, 64, 50, 0.07);
  }
  .icon-btn:active {
    transform: scale(0.92);
  }
  .icon-btn :global(svg) {
    width: 24px;
    height: 24px;
  }
  .cart-btn__count {
    position: absolute;
    top: 4px;
    right: 2px;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    border-radius: 999px;
    background: var(--clay-deep);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 20px;
    text-align: center;
  }
  .cart-btn__count.bump {
    animation: bump 0.6s var(--ease-spring);
  }
  @keyframes bump {
    40% {
      transform: scale(1.5);
    }
  }
  .menu-btn {
    display: none;
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: var(--cream);
    overflow-y: auto;
    padding-bottom: 2rem;
  }
  .mobile-menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 68px;
  }
  .mobile-menu ul {
    list-style: none;
    padding: 1rem 0 2rem;
    margin: 0;
  }
  .mobile-menu li {
    animation: menuIn 0.6s var(--ease-out) both;
    animation-delay: calc(var(--i) * 50ms);
  }
  .mobile-menu li a {
    display: block;
    padding: 0.5rem 0;
    font-family: var(--font-hand);
    font-size: 2.3rem;
    text-decoration: none;
    border-bottom: 1px dashed rgba(91, 64, 50, 0.18);
  }
  @keyframes menuIn {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @media (max-width: 960px) {
    .site-nav,
    .site-header__shop {
      display: none;
    }
    .menu-btn {
      display: grid;
    }
  }
</style>

<script>
  const header = document.querySelector('[data-header]');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');
  const setMenu = (open: boolean) => {
    if (!menu || !openBtn) return;
    menu.hidden = !open;
    openBtn.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (open) closeBtn?.focus();
    else openBtn.focus();
  };
  openBtn?.addEventListener('click', () => setMenu(true));
  closeBtn?.addEventListener('click', () => setMenu(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.hidden) setMenu(false);
  });
</script>
