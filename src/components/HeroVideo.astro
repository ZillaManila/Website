---
// Full-width film under the hero. Muted, loops, plays only while on screen,
// and can be paused. Reduced-motion visitors see the still poster instead.
interface Props {
  mp4: string;
  webm?: string;
  poster: string;
  label: string;
}
const { mp4, webm, poster, label } = Astro.props;
---

<section class="film" aria-label={label} data-film>
  <div class="film__frame" data-film-frame>
    <video class="film__video" muted loop playsinline preload="metadata" poster={poster} aria-label={label} data-film-video>
      {webm && <source src={webm} type="video/webm" />}
      <source src={mp4} type="video/mp4" />
    </video>
    <div class="film__shade" aria-hidden="true"></div>
    <div class="film__caption">
      <p class="hand film__title">Small creatures. <br />Big comfort.</p>
      <p class="film__sub">Every Gummikins is made by hand to be held, squeezed, and loved.</p>
    </div>
    <button type="button" class="film__toggle" data-film-toggle aria-label="Pause video" aria-pressed="false">
      <svg class="film__pause" viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="5" width="3.5" height="14" rx="1.2"></rect><rect x="13.5" y="5" width="3.5" height="14" rx="1.2"></rect></svg>
      <svg class="film__play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.2-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z"></path></svg>
    </button>
  </div>
</section>

<style>
  .film {
    padding-block: 0 clamp(2.5rem, 6vw, 4rem);
  }
  .film__frame {
    --p: 0;
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    max-height: 88vh;
    overflow: hidden;
    background: #e9dccb url('/video/cloud-dream-poster.jpg') center / cover no-repeat;
    /* Starts as an inset rounded card and opens to full width as you scroll in. */
    clip-path: inset(0 calc((1 - var(--p)) * 4vw) round calc((1 - var(--p)) * 36px));
    will-change: clip-path;
  }
  @media (min-width: 760px) {
    .film__frame {
      aspect-ratio: 16 / 9;
    }
  }
  .film__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(calc(1.12 - var(--p) * 0.12));
  }
  .film__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(63, 43, 33, 0) 45%, rgba(63, 43, 33, 0.55) 100%);
    pointer-events: none;
  }
  .film__caption {
    position: absolute;
    left: var(--gutter);
    right: 5rem;
    bottom: clamp(1.25rem, 4vw, 3rem);
    color: #fff;
    opacity: calc(var(--p) * 1.4 - 0.2);
    transform: translateY(calc((1 - var(--p)) * 24px));
  }
  .film__title {
    margin: 0;
    font-size: clamp(2rem, 5.5vw, 4rem);
    line-height: 1;
    text-shadow: 0 2px 18px rgba(63, 43, 33, 0.45);
  }
  .film__sub {
    margin: 0.6rem 0 0;
    font-size: clamp(0.95rem, 1.6vw, 1.1rem);
    font-weight: 550;
    max-width: 38ch;
    text-shadow: 0 1px 10px rgba(63, 43, 33, 0.5);
  }
  .film__toggle {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(1.25rem, 4vw, 3rem);
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 50%;
    background: rgba(63, 43, 33, 0.35);
    backdrop-filter: blur(8px);
    color: #fff;
    cursor: pointer;
    transition: transform 0.3s var(--ease-spring), background-color 0.2s;
  }
  .film__toggle:hover {
    background: rgba(63, 43, 33, 0.55);
    transform: scale(1.06);
  }
  .film__toggle svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }
  .film__play,
  .film.is-paused .film__pause {
    display: none;
  }
  .film.is-paused .film__play {
    display: block;
  }
  @media (max-width: 759px) {
    .film__frame {
      overflow: visible;
      background: none;
      aspect-ratio: auto;
      max-height: none;
      clip-path: none;
    }
    .film__frame::before {
      content: '';
      display: block;
      aspect-ratio: 4 / 3;
    }
    .film__video,
    .film__shade {
      bottom: auto;
      height: auto;
      aspect-ratio: 4 / 3;
      clip-path: inset(0 calc((1 - var(--p)) * 4vw) round calc((1 - var(--p)) * 28px));
    }
    .film__shade {
      display: none;
    }
    .film__caption {
      position: static;
      padding: 1.25rem var(--gutter) 0;
      color: var(--chocolate-deep);
      opacity: 1;
      transform: none;
    }
    .film__title,
    .film__sub {
      text-shadow: none;
    }
    .film__title br {
      display: none;
    }
    .film__sub {
      color: var(--ink-soft);
    }
    .film__toggle {
      top: calc(100vw * 0.75 - 60px);
      bottom: auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .film__video,
    .film__frame {
      clip-path: none;
    }
    .film__video {
      transform: none;
    }
    .film__caption {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const film = document.querySelector<HTMLElement>('[data-film]');
  const frame = film?.querySelector<HTMLElement>('[data-film-frame]');
  const video = film?.querySelector<HTMLVideoElement>('[data-film-video]');
  const toggle = film?.querySelector<HTMLButtonElement>('[data-film-toggle]');

  if (film && frame && video && toggle) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let userPaused = reduce;
    let onScreen = false;

    const setPaused = (paused: boolean) => {
      film.classList.toggle('is-paused', paused);
      toggle.setAttribute('aria-pressed', String(paused));
      toggle.setAttribute('aria-label', paused ? 'Play video' : 'Pause video');
    };

    const sync = () => {
      if (onScreen && !userPaused) {
        video.play().then(() => setPaused(false)).catch(() => setPaused(true));
      } else {
        video.pause();
        setPaused(true);
      }
    };

    toggle.addEventListener('click', () => {
      userPaused = !video.paused ? true : false;
      sync();
    });

    new IntersectionObserver(
      ([e]) => {
        onScreen = e.isIntersecting;
        if (onScreen && video.preload !== 'auto') video.preload = 'auto';
        sync();
      },
      { threshold: 0.25 }
    ).observe(frame);

    // Scroll-linked reveal: 0 when the film's top enters the viewport, 1 once it's well in view.
    if (!reduce) {
      let ticking = false;
      const update = () => {
        ticking = false;
        const r = frame.getBoundingClientRect();
        const vh = window.innerHeight;
        const p = Math.min(1, Math.max(0, (vh - r.top) / (vh * 0.75)));
        frame.style.setProperty('--p', p.toFixed(3));
      };
      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        },
        { passive: true }
      );
      update();
    } else {
      frame.style.setProperty('--p', '1');
      setPaused(true);
    }
  }
</script>
