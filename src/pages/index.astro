<script>
  const stage = document.getElementById('hero-plush');
  const name = document.querySelector<HTMLOutputElement>('[data-swatch-name]');
  document.querySelectorAll<HTMLInputElement>('input[name="hero-color"]').forEach((input) => {
    input.addEventListener('change', () => {
      if (!stage) return;
      stage.dispatchEvent(new CustomEvent('plush:color', { detail: input.value }));
      const img = stage.querySelector<HTMLImageElement>('.plush3d__fallback');
      if (img && input.dataset.image) img.src = input.dataset.image;
      if (name) name.value = input.parentElement?.querySelector('.visually-hidden')?.textContent || '';
    });
  });
</script>
