---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<Base title="Journal" description="Stories from the world of Gummikins™: handmade process, gift ideas, care tips, and new batches.">
  <section class="wrap page-head">
    <p class="eyebrow">Journal</p>
    <h1>Notes from the burrow</h1>
    <p>Behind-the-scenes stories, gift ideas, and news about new batches.</p>
  </section>
  <section class="wrap posts">
    {
      posts.map((p, i) => (
        <article class:list={['post-card reveal', { 'post-card--lead': i === 0 }]} style={`--i:${i}`}>
          <a href={`/journal/${p.id}`}>
            <div class="post-card__img">
              <img src={p.data.image} alt={p.data.imageAlt} loading="lazy" width="1200" height="1200" />
            </div>
            <div class="post-card__body">
              <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
              <h2>{p.data.title}</h2>
              <p>{p.data.description}</p>
            </div>
          </a>
        </article>
      ))
    }
  </section>
</Base>

<style>
  .posts {
    display: grid;
    gap: 2rem;
  }
  .post-card a {
    display: grid;
    gap: 1.25rem;
    text-decoration: none;
    color: inherit;
  }
  .post-card__img {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    background: var(--paper);
    overflow: hidden;
  }
  .post-card__img img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.6s var(--ease-out);
  }
  .post-card a:hover img {
    transform: scale(1.05);
  }
  .post-card time {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--moss-deep);
  }
  .post-card h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    margin: 0.3rem 0 0.5rem;
  }
  .post-card p {
    color: var(--ink-soft);
  }
  @media (min-width: 860px) {
    .posts {
      grid-template-columns: 1fr 1fr;
      gap: 3rem 2rem;
    }
    .post-card--lead {
      grid-column: 1 / -1;
    }
    .post-card--lead a {
      grid-template-columns: 1.2fr 1fr;
      align-items: center;
      gap: 3rem;
    }
  }
</style>
