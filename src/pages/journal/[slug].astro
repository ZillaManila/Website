---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}
const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const { Content } = await render(post);
const date = post.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  image: new URL(post.data.image, Astro.site).toString(),
  publisher: { '@type': 'Organization', name: 'Gummikins' },
};
---

<Base title={post.data.title} description={post.data.description} image={post.data.image} type="article">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <article class="wrap article">
    <a href="/journal" class="article__back">← Journal</a>
    <time datetime={post.data.date.toISOString()}>{date}</time>
    <h1>{post.data.title}</h1>
    <p class="lede">{post.data.description}</p>
    <figure class="article__img">
      <img src={post.data.image} alt={post.data.imageAlt} width="1200" height="1200" />
    </figure>
    <div class="prose"><Content /></div>
    <aside class="article__cta">
      <p class="hand">Ready to meet yours?</p>
      <a href="/shop" class="btn">Shop Gummikins <Icon name="arrow" /></a>
    </aside>
  </article>
</Base>

<style>
  .article {
    max-width: 820px;
    padding-top: clamp(2rem, 5vw, 3.5rem);
  }
  .article__back {
    display: inline-block;
    margin-bottom: 1.5rem;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .article time {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--moss-deep);
  }
  .article__img {
    margin: 2rem 0;
    border-radius: var(--radius-lg);
    background: var(--paper);
    overflow: hidden;
  }
  .article__img img {
    width: 100%;
    max-height: 520px;
    object-fit: contain;
  }
  .article__cta {
    margin-top: 3rem;
    padding: 2rem;
    border-radius: var(--radius-lg);
    background: #f5e0dd;
    text-align: center;
  }
  .article__cta .hand {
    font-size: 2rem;
    margin: 0 auto 1rem;
  }
</style>
