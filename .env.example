# Copy to .env for local development. On Vercel, add these under
# Project → Settings → Environment Variables.

# Owner portal: the secret part of the link (gummikins.com/<ADMIN_PATH>) and its password.
# Use something long and unguessable for both. Required on the live site; the portal is off without them.
ADMIN_PATH=
ADMIN_PASSWORD=

# Optional extra secret mixed into sign-in cookies. Changing it signs everyone out.
SESSION_SECRET=

# Added automatically when you connect storage in Vercel (Storage tab):
# DATABASE_URL=        (Neon Postgres)
# BLOB_READ_WRITE_TOKEN= (Vercel Blob, for product photos)
